# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=phishguard
CORS_ORIGINS=http://localhost:3000

# E-mail inbox scanning (optional, see docs/EMAIL_SETUP.md)
PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
EMAIL_POLL_SECONDS=0

# Voice scanner (optional, needs requirements-voice.txt)
# tiny | base | small | medium  (bigger = more accurate, slower)
WHISPER_MODEL=small
